diff --git a/src/portable/raspberrypi/rp2040/hcd_rp2040.c b/src/portable/raspberrypi/rp2040/hcd_rp2040.c
index 9c3738476..196711671 100644
--- a/src/portable/raspberrypi/rp2040/hcd_rp2040.c
+++ b/src/portable/raspberrypi/rp2040/hcd_rp2040.c
@@ -115,7 +115,8 @@ static void __tusb_irq_path_func(sie_start_xfer)(bool send_setup, bool is_rx, bo
     sie_ctrl |= (is_rx ? USB_SIE_CTRL_RECEIVE_DATA_BITS : USB_SIE_CTRL_SEND_DATA_BITS);
   }
   if (need_pre) {
-    sie_ctrl |= USB_SIE_CTRL_PREAMBLE_EN_BITS;
+    // start at SOF: a low-speed transaction run into the end of the frame times out behind the hub
+    sie_ctrl |= USB_SIE_CTRL_PREAMBLE_EN_BITS | USB_SIE_CTRL_SOF_SYNC_BITS;
   }

   // START_TRANS bit on SIE_CTRL has the same behavior as the AVAILABLE bit
@@ -306,8 +307,11 @@ static void __tusb_irq_path_func(handle_buf_status_isr)(void) {
     // Clear switch request so the 2-SOF fallback only fires for NAK-retrying endpoints.
     epx_switch_request = false;
   #endif
-    if (rp2usb_xfer_continue(epx, ep_reg, buf_reg, buf_id, tu_edpt_dir(epx->ep_addr) == TUSB_DIR_IN)) {
+    const bool is_rx = tu_edpt_dir(epx->ep_addr) == TUSB_DIR_IN;
+    if (rp2usb_xfer_continue(epx, ep_reg, buf_reg, buf_id, is_rx)) {
       xfer_complete_isr(epx, XFER_RESULT_SUCCESS, true);
+    } else if (epx->need_pre) {
+      sie_start_xfer(false, is_rx, true); // one packet per transaction, see bufctrl_prepare16()
     }
   }

@@ -496,7 +500,11 @@ static void __tusb_irq_path_func(hcd_rp2040_irq)(void) {

   if (status & USB_INTS_ERROR_DATA_SEQ_BITS) {
     usb_hw_clear->sie_status = USB_SIE_STATUS_DATA_SEQ_ERROR_BITS;
-    panic("Data Seq Error \n");
+    // fail rather than panic: a control retry restarts from SETUP, which resets the toggle
+    if (epx->state == EPSTATE_ACTIVE) {
+      sie_stop_xfer();
+      xfer_complete_isr(epx, XFER_RESULT_FAILED, true);
+    }
   }
 }

diff --git a/src/portable/raspberrypi/rp2040/rp2040_usb.c b/src/portable/raspberrypi/rp2040/rp2040_usb.c
