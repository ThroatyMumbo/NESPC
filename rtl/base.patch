+	assign sst_do			= map_out_game.sst_di;
+	assign mai.sst.addr	= pi.addr[12:0];
+	assign mai.sst.act	= 0;
+	assign mai.sst.act_mc	= 0;
+	assign mai.sst.we		= pi.map.ce_sst & pi.we & pi.act;
+	assign mai.sst.we_reg	= 0;
+	assign mai.sst.we_mem	= 0;
+	assign mai.sst.dato	= pi.dato;
 `endif
